# Copia este archivo a .env y ajusta los valores
ENTORNO=local
DATABASE_URL=postgresql+psycopg://padel:padel@localhost:5432/padel
CORS_ORIGINS=["http://localhost:4321"]
SESION_DIAS=30
TOKEN_ACCESO_MINUTOS=15

# Protege GET /internas/catalogo (lo usa el build de la web). Vacío = abierto (solo en local).
# TOKEN_INTERNO=

# Explicaciones con IA. Sin clave se usa la plantilla.
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-haiku-5-5
# IA_LLAMADAS_DIARIAS_MAX=500
# Cada mañana se dejan explicados los perfiles más repetidos de los últimos días.
# IA_PREGENERAR_MAX=100
# IA_PREGENERAR_DIAS=7

# Recompilar la web tras importar los feeds (GitHub repository_dispatch).
# GITHUB_TOKEN=

# Copia de seguridad diaria en Cloudflare R2 (API compatible con S3).
# BACKUP_S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
