#!/usr/bin/env bash
# Valida Conventional Commits (docs/GITFLOW.md). Activar: git config core.hooksPath .githooks
primera=$(head -n1 "$1")

# Merges, reverts y fixups automáticos de git pasan sin validar.
[[ "$primera" =~ ^(Merge|Revert|fixup!|squash!) ]] && exit 0

patron='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'
if ! [[ "$primera" =~ $patron ]]; then
  echo "✗ Mensaje de commit no válido:  $primera" >&2
  echo "  Formato: <tipo>(<ámbito>): <resumen>   p. ej.  feat(frontend): retomar encuesta" >&2
  echo "  Tipos: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
