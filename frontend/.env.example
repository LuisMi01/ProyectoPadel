# URL pública de la API FastAPI.
# En desarrollo, si no se define, se usa http://localhost:8000.
# En producción, si no se define, la web se publica sin acceso por correo (todo lo demás funciona).
PUBLIC_API_URL=http://localhost:8000

# Dominio público de la web (URL canónicas y Open Graph). Solo hace falta con dominio propio:
# en Vercel, si no se define, se usa el dominio de producción del proyecto; en local, localhost:4321.
# SITE_URL=https://palaideal.es
