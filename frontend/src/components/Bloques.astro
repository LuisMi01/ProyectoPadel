---
/** Pinta el contenido en bloques de las guías y de las páginas de texto. */
import PalaMini from "@/components/PalaMini";
import { palas as catalogo, palaPorSlug } from "@/data/catalogo";
import type { Bloque, CriteriosPalas } from "@/data/guias";
import { type Caras, type Pala, mejorOferta, textoCaracter, textoFormaPlural } from "@/lib/catalogo";

interface Props {
  bloques: Bloque[];
}

const { bloques } = Astro.props;

type BloquePalas = Extract<Bloque, { tipo: "palas" }>;

/** Precio de la mejor oferta disponible; Infinity si ninguna tienda la tiene. */
const precio = (pala: Pala) => mejorOferta(pala)?.precio ?? Infinity;

function cumple(pala: Pala, c: CriteriosPalas): boolean {
  const euros = precio(pala);
  return (
    !pala.junior &&
    euros !== Infinity &&
    (!c.formas || c.formas.includes(pala.forma)) &&
    (!c.balances || c.balances.includes(pala.balance)) &&
    (c.durezaMax === undefined || pala.dureza <= c.durezaMax) &&
    (c.pesoMax === undefined || pala.peso <= c.pesoMax) &&
    (!c.caras || c.caras.includes(pala.caras)) &&
    euros >= (c.precioMin ?? 0) &&
    euros <= (c.precioMax ?? Infinity)
  );
}

/** Las palas fijadas a mano o las que cumplen los criterios, de la más barata a la más cara. */
function palasDelBloque({ slugs, criterios }: BloquePalas): Pala[] {
  if (slugs) return slugs.map(palaPorSlug).filter((p): p is Pala => p !== undefined);
  const lasQueCumplen = (c: CriteriosPalas) =>
    catalogo.filter((pala) => cumple(pala, c)).sort((a, b) => precio(a) - precio(b));
  if (criterios.length === 1) return lasQueCumplen(criterios[0]).slice(0, 3);
  const elegidas = criterios.flatMap((c) => lasQueCumplen(c).slice(0, 1));
  return elegidas.filter((pala, i) => elegidas.indexOf(pala) === i);
}

/** «a, b o c» y «a, b y c». */
const unir = (partes: string[], nexo: "o" | "y") =>
  partes.length < 2 ? partes.join("") : `${partes.slice(0, -1).join(", ")} ${nexo} ${partes.at(-1)}`;

const TEXTO_CARAS: Record<Caras, string> = { fibra: "fibra de vidrio", hibrida: "fibra y carbono", carbono: "carbono" };

/** «redondas, de balance bajo, con núcleo blando o medio, de 360 g o menos y de hasta 130 €». */
function describir(c: CriteriosPalas): string {
  const partes: string[] = [];
  if (c.formas) partes.push(unir(c.formas.map((f) => textoFormaPlural[f].toLowerCase()), "o"));
  if (c.balances) partes.push(`de balance ${unir(c.balances, "o")}`);
  if (c.durezaMax !== undefined) {
    partes.push(c.durezaMax <= 2 ? "con núcleo blando" : c.durezaMax === 3 ? "con núcleo blando o medio" : "sin núcleo duro");
  }
  if (c.pesoMax !== undefined) partes.push(`de ${c.pesoMax} g o menos`);
  if (c.caras) partes.push(`con caras de ${unir(c.caras.map((x) => TEXTO_CARAS[x]), "o")}`);
  if (c.precioMin !== undefined && c.precioMax !== undefined) partes.push(`de entre ${c.precioMin} y ${c.precioMax} €`);
  else if (c.precioMax !== undefined) partes.push(`de hasta ${c.precioMax} €`);
  else if (c.precioMin !== undefined) partes.push(`desde ${c.precioMin} €`);
  return unir(partes, "y");
}

/** Frase bajo el título: qué cumplen las palas y en qué orden van. */
function explicar({ slugs, criterios }: BloquePalas): string | null {
  if (slugs) return null;
  if (criterios.length === 1) {
    return `Cumplen lo que pide esta guía: ${describir(criterios[0])}. Van de la más barata a la más cara.`;
  }
  return `La más barata que hay ahora en el catálogo de cada tipo: ${unir(criterios.map(describir), "y")}.`;
}
---

<div class="prosa">
  {
    bloques.map((bloque) => {
      switch (bloque.tipo) {
        case "p":
          return <p>{bloque.texto}</p>;
        case "h2":
          return <h2 class="titulo">{bloque.texto}</h2>;
        case "lista":
          return (
            <ul class="lista">
              {bloque.elementos.map((texto) => (
                <li>{texto}</li>
              ))}
            </ul>
          );
        case "definiciones":
          return (
            <dl class="definiciones">
              {bloque.elementos.map(({ termino, texto }) => (
                <div>
                  <dt>{termino}</dt>
                  <dd>{texto}</dd>
                </div>
              ))}
            </dl>
          );
        case "tabla":
          return (
            <div class="tabla">
              <table>
                <thead>
                  <tr>
                    {bloque.cabecera.map((celda) => (
                      <th scope="col">{celda}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {bloque.filas.map((fila) => (
                    <tr>
                      {fila.map((celda, i) =>
                        i === 0 ? <th scope="row">{celda}</th> : <td data-rotulo={bloque.cabecera[i]}>{celda}</td>,
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          );
        case "nota":
          return (
            <aside class="nota">
              <p>
                <strong>{/[.?!:…]$/.test(bloque.titulo) ? bloque.titulo : `${bloque.titulo}.`}</strong> {bloque.texto}
              </p>
            </aside>
          );
        case "palas": {
          // Sin palas que enseñar (catálogo vacío o nada dentro del tope) no se pinta el título solo.
          const palas = palasDelBloque(bloque);
          if (palas.length === 0) return null;
          return (
            <section class="palas">
              <h2 class="titulo">{bloque.titulo}</h2>
              {explicar(bloque) && <p class="explica">{explicar(bloque)}</p>}
              <div class="rejilla-palas">
                {palas.map((pala) => (
                  <PalaMini pala={pala} texto={`${pala.junior ? "Junior" : textoCaracter[pala.forma]} · ${pala.marca}`} />
                ))}
              </div>
            </section>
          );
        }
      }
    })
  }
</div>

<style>
  .prosa {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 18px;
    line-height: 1.6;
  }
  .prosa > p {
    margin: 0;
    text-wrap: pretty;
  }
  h2 {
    margin-top: 24px;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .prosa > :first-child {
    margin-top: 0;
  }

  .lista {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lista li {
    position: relative;
    padding-left: 26px;
    text-wrap: pretty;
  }
  .lista li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--azul);
  }

  .definiciones {
    display: flex;
    flex-direction: column;
    margin: 0;
    border-top: 1.5px solid var(--tinta);
  }
  .definiciones > div {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--borde);
  }
  .definiciones dt {
    flex: 0 0 200px;
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .definiciones dd {
    flex: 1 1 300px;
    margin: 0;
    font-size: 17px;
    color: var(--suave);
    text-wrap: pretty;
  }

  .tabla {
    padding: 8px 22px;
    border-radius: 20px;
    background: var(--blanco);
    border: 1px solid var(--borde);
    font-size: 16px;
    line-height: 1.45;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  thead th {
    padding: 14px 14px 12px 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--suave);
  }
  tbody tr {
    border-top: 1px solid var(--borde);
  }
  tbody th,
  td {
    padding: 14px 14px 14px 0;
    vertical-align: top;
  }
  tbody th {
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  td {
    color: var(--suave);
  }

  .nota {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 24px;
    border-radius: 18px;
    background: var(--tenue);
    font-size: 17px;
  }
  .nota p {
    margin: 0;
    text-wrap: pretty;
  }
  .nota strong {
    color: var(--azul);
  }

  .palas {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .palas .explica {
    margin: -8px 0 0;
    font-size: 16px;
    color: var(--suave);
    text-wrap: pretty;
  }

  /* En móvil las tablas pasan a fichas: la primera columna hace de título. */
  @media (max-width: 640px) {
    .prosa {
      font-size: 17px;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    table,
    tbody,
    tr,
    tbody th,
    td {
      display: block;
    }
    tbody tr {
      padding: 14px 0;
    }
    tbody tr:first-child {
      border-top: 0;
    }
    tbody th,
    td {
      padding: 0;
    }
    td {
      margin-top: 6px;
    }
    td::before {
      content: attr(data-rotulo) ": ";
      font-weight: 600;
      color: var(--tinta);
    }
    .definiciones dt {
      flex-basis: 100%;
    }
  }
</style>
