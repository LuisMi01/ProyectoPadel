---
/** Gráfico escalonado del precio más bajo entre tiendas en los últimos 90 días. */
import type { Pala } from "@/lib/catalogo";
import { graficoPrecio } from "@/lib/fichas";

interface Props {
  pala: Pala;
}

const g = graficoPrecio(Astro.props.pala);
---

<div class="historico">
  <div class="cabeza">
    <h2 class="titulo">{g.titular}</h2>
    <p>Precio más bajo entre tiendas, últimos 90 días.</p>
  </div>
  <div class="lienzo">
    <svg role="img" aria-label={g.descripcion} viewBox="0 0 860 290">
      <g stroke-width="1" style="stroke: var(--borde)">
        {g.marcasY.map(({ y }) => <path d={`M60 ${y} H840`} />)}
        <path d="M60 240 H840" style="stroke: var(--tinta)"></path>
      </g>
      <g class="ejes" font-size="18" style="fill: var(--suave)">
        {
          g.marcasY.map(({ y, texto }) => (
            <text x="48" y={y + 4} text-anchor="end">
              {texto}
            </text>
          ))
        }
        <text x="60" y="266">hace 90 días</text>
        <text x="320" y="266" text-anchor="middle">60</text>
        <text x="580" y="266" text-anchor="middle">30</text>
        <text x="840" y="266" text-anchor="end">hoy</text>
      </g>
      <path class="ar" d={g.area} style="fill: var(--azul-tinte)"></path>
      <path
        class="ln"
        pathLength="1"
        d={g.linea}
        fill="none"
        stroke-width="3.5"
        stroke-linejoin="round"
        stroke-linecap="round" style="stroke: var(--azul)"></path>
      <g class="ar rotulos" font-size="18" font-weight="700" style="fill: var(--tinta)">
        {
          g.minimo && (
            <>
              <circle cx={g.minimo.x} cy={g.minimo.y} r="7" stroke-width="2.5" style="fill: var(--lima); stroke: var(--tinta)" />
              <text x={g.minimo.x} y={g.minimo.y + 28} text-anchor={g.minimo.ancla}>
                {g.minimo.texto}
              </text>
            </>
          )
        }
        <circle cx={g.hoy.x} cy={g.hoy.y} r="7" stroke-width="2.5" style="fill: var(--azul); stroke: var(--blanco)"></circle>
        <text x={g.hoy.x - 12} y={g.hoy.y - 14} text-anchor="end">{g.hoy.texto}</text>
      </g>
    </svg>
  </div>
</div>

<style>
  .historico {
    flex: 2 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(22px, 2.8vw, 36px);
    border-radius: 22px;
    background: var(--blanco);
    border: 1px solid var(--borde);
  }
  .cabeza {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  h2 {
    font-size: 30px;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  p {
    margin: 0;
    font-size: 15px;
    color: var(--suave);
  }
  /* En pantallas estrechas el gráfico conserva su tamaño y se desplaza en horizontal. */
  .lienzo {
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 540px;
    height: auto;
  }
  .ejes {
    font-variant-numeric: tabular-nums;
  }
  .rotulos {
    font-family: var(--f-texto);
  }
  /* Halo del color de la tarjeta: los rótulos se leen aunque crucen un escalón de la línea. */
  .rotulos text {
    paint-order: stroke;
    stroke: var(--blanco);
    stroke-width: 6px;
    stroke-linejoin: round;
  }
  .ln {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2s cubic-bezier(0.5, 0, 0.2, 1) 0.2s forwards;
  }
  .ar {
    opacity: 0;
    animation: fade 0.9s 1.6s forwards;
  }
</style>
