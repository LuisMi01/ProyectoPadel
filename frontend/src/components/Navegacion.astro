---
/**
 * Barra de navegación. La usan la portada (sobre el azul del hero) y la
 * cabecera blanca del resto de páginas. Por debajo de 820 px los enlaces pasan
 * a un menú desplegable.
 */
import Icono from "@/components/Icono";
import Logo from "@/components/Logo.astro";
import { type SeccionNav, navTransparencia, navegacion, rutas } from "@/lib/rutas";

interface Props {
  tono: "oscuro" | "claro";
  /** Botón de la derecha: acceso a la cuenta o llamada al cuestionario. */
  accion?: "acceder" | "cuestionario";
  activo?: SeccionNav;
  /** La portada añade «Cómo ganamos dinero» a los enlaces. */
  conTransparencia?: boolean;
}

const { tono, accion = "acceder", activo, conTransparencia = false } = Astro.props;
const enlaces = conTransparencia ? [...navegacion, navTransparencia] : navegacion;
---

<nav aria-label="Principal" class:list={["nav", tono]}>
  <Logo tono={tono} />

  <div class="navlinks">
    {
      enlaces.map(({ id, texto, href }) => (
        <a class="nv" href={href} aria-current={activo === id ? "page" : undefined}>
          {texto}
        </a>
      ))
    }
  </div>

  <div class="fin">
    {
      accion === "cuestionario" ? (
        <a class="btn btn-s btn-azul cta" href={rutas.encuesta}>
          Encontrar mi pala
        </a>
      ) : (
        <a class="nv acceder" href={rutas.acceso} data-acceso>
          Acceder
        </a>
      )
    }

    <details class="menu">
      <summary aria-label="Menú">
        <Icono nombre="menu" tamano={24} grosor={2.2} class="abrir" />
        <Icono nombre="cruz" tamano={24} grosor={2.2} class="cerrar" />
      </summary>
      <div class="panel">
        {
          [...navegacion, navTransparencia].map(({ id, texto, href }) => (
            <a href={href} aria-current={activo === id ? "page" : undefined}>
              {texto}
            </a>
          ))
        }
        <a href={rutas.acceso} data-acceso>Acceder</a>
      </div>
    </details>
  </div>
</nav>

<script>
  // El menú móvil se cierra al pulsar fuera o con Escape.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>("details.menu")) {
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>

<style>
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .oscuro {
    padding: 22px 0;
    color: var(--blanco);
  }
  .claro {
    padding: 14px 0;
  }

  .navlinks {
    display: flex;
    align-items: center;
    gap: 34px;
    font-size: 16px;
    font-weight: 500;
  }
  .navlinks a {
    padding: 12px 0;
  }
  .claro .nv {
    opacity: 0.8;
  }
  .claro .nv:hover {
    opacity: 1;
  }
  .navlinks a[aria-current="page"] {
    opacity: 1;
    font-weight: 700;
  }

  .fin {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .acceder {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 10px;
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
  }
  .claro .acceder {
    border-color: var(--tinta);
    opacity: 1;
  }
  .cta {
    font-weight: 700;
  }

  /* Menú móvil */
  .menu {
    display: none;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 10px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .claro summary {
    border-color: var(--tinta);
  }
  .menu :global(.cerrar),
  .menu[open] :global(.abrir) {
    display: none;
  }
  .menu[open] :global(.cerrar) {
    display: block;
  }
  .panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    padding: 8px 20px;
    border-radius: 18px;
    background: var(--noche);
    color: var(--blanco);
    box-shadow: 0 28px 44px -24px rgba(8, 21, 53, 0.7);
    animation: pop 0.25s var(--curva) both;
  }
  .claro .panel {
    top: calc(100% + 1px);
    border: 1px solid var(--borde);
    background: var(--blanco);
    color: var(--tinta);
    box-shadow: 0 28px 44px -28px rgba(10, 27, 61, 0.45);
  }
  .panel a {
    display: flex;
    align-items: center;
    min-height: 54px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    font-family: var(--f-titulo);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: none;
  }
  .claro .panel a {
    border-bottom-color: var(--borde);
  }
  .panel a:last-child {
    border-bottom: 0;
  }
  .panel a[aria-current="page"] {
    color: var(--lima);
  }
  .claro .panel a[aria-current="page"] {
    color: var(--azul);
  }

  @media (max-width: 820px) {
    .navlinks {
      display: none;
    }
    .menu {
      display: block;
    }
    .nav {
      gap: 12px;
    }
  }

  /* En pantallas muy estrechas el logo y el botón de la cabecera se compactan. */
  @media (max-width: 400px) {
    .nav {
      gap: 8px;
    }
    .nav :global(.logo) {
      gap: 8px;
      font-size: 22px;
    }
    .fin {
      gap: 8px;
    }
    .acceder,
    .cta {
      padding: 0 10px;
      font-size: 14.5px;
    }
  }

  /* Por debajo de 350 px no cabe la llamada al cuestionario: queda en el menú. */
  @media (max-width: 350px) {
    .cta {
      display: none;
    }
  }
</style>
