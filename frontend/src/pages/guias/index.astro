---
import Icono from "@/components/Icono";
import ListaGuias from "@/components/ListaGuias.astro";
import { guias } from "@/data/guias";
import Base from "@/layouts/Base.astro";
import { rutas } from "@/lib/rutas";
---

<Base
  titulo="Guías para elegir pala de pádel"
  descripcion="Guías claras para elegir pala de pádel: formas, balance, peso, núcleo, molestias y presupuesto. Sin jerga de catálogo."
  accion="cuestionario"
  activo="guias"
>
  <main id="contenido">
    <section class="contenedor cabeza">
      <p class="kicker s1">Guías</p>
      <h1 class="titulo t-pagina s1">Guías para elegir bien.</h1>
      <p class="lead s2">
        Lo que conviene saber antes de comprar una pala, explicado sin jerga de catálogo. Si un término técnico importa,
        lo explicamos en la misma frase.
      </p>
    </section>

    <section class="contenedor lista s3">
      <ListaGuias guias={guias} conResumen />
    </section>

    <section class="contenedor cierre">
      <div class="banda-pista dk banda rv">
        <svg class="pista" aria-hidden="true" viewBox="0 0 1128 300" preserveAspectRatio="xMidYMid slice">
          <g fill="none" stroke="#FFFFFF" stroke-opacity="0.22" stroke-width="3">
            <path d="M-20 232 L1150 232"></path>
            <path d="M820 -20 L820 320"></path>
            <path d="M820 110 L1150 110"></path>
          </g>
          <circle cx="940" cy="86" r="22" fill="#D9F53B"></circle>
        </svg>
        <div class="banda-dentro">
          <h2 class="titulo">¿Prefieres ir al grano?</h2>
          <a class="btn btn-xl btn-lima" href={rutas.encuesta}>
            Responder 6 preguntas
            <Icono nombre="flecha" tamano={22} grosor={2.4} class="arr" />
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .cabeza {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-block: clamp(32px, 5vw, 64px) clamp(28px, 4vw, 48px);
  }
  .lead {
    margin: 0;
    max-width: 640px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--suave);
    text-wrap: pretty;
  }
  .lista {
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  .cierre {
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  .banda {
    border-radius: 28px;
  }
  .banda-dentro {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: clamp(28px, 4.4vw, 56px);
  }
  .banda h2 {
    flex: 1 1 380px;
    max-width: 620px;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
</style>
