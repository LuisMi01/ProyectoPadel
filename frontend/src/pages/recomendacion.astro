---
import "@/styles/recomendacion.css";
import Recomendacion from "@/components/Recomendacion";
import Base from "@/layouts/Base.astro";
import { rutas } from "@/lib/rutas";
---

<Base
  titulo="Tu recomendación de pala"
  descripcion="La pala que encaja con tus respuestas, por qué la recomendamos y dónde está más barata hoy."
  accion="acceder"
  pie="compacto"
  noindex
>
  <!-- La recomendación se calcula en el navegador con las respuestas del cuestionario. -->
  <Recomendacion client:load />

  <noscript>
    <div class="contenedor" style="padding-block:48px">
      <p>
        Para calcular tu recomendación hace falta JavaScript. Mientras tanto puedes
        <a class="lnk lnk-azul" href={rutas.palas}>ver todas las palas</a>.
      </p>
    </div>
  </noscript>
</Base>
