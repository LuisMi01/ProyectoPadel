---
import ListaGuias from "@/components/ListaGuias.astro";
import Navegacion from "@/components/Navegacion.astro";
import { Silueta } from "@/components/dibujos";
import { guiasDestacadas } from "@/data/guias";
import Base from "@/layouts/Base.astro";
import { type Forma, textoCaracter, textoForma } from "@/lib/catalogo";
import { rutas } from "@/lib/rutas";
import { sitio } from "@/lib/sitio";

const pasos = [
  {
    titulo: "Respondes 6 preguntas",
    texto:
      "Experiencia, frecuencia, estilo, molestias, edad y presupuesto. Si todavía no has jugado, nos saltamos dos.",
  },
  {
    titulo: "Te explicamos la elección",
    texto: "No solo un nombre: qué forma, qué balance y qué dureza te convienen, y qué respuesta tuya lo decide.",
  },
  {
    titulo: "Compras donde quieras",
    texto:
      "Comparamos el precio en varias tiendas y te llevamos a la que la tiene más barata. Nosotros no vendemos nada.",
  },
];

const preguntas = [
  ["Experiencia", "Cuánto margen de error necesitas", "Forma y tamaño del punto dulce"],
  ["Frecuencia", "Cuánto trabajo le das al brazo y a la pala", "Peso y resistencia de los materiales"],
  ["Estilo", "Si construyes el punto o prefieres terminarlo", "Balance: bajo para control, alto para potencia"],
  ["Molestias", "Si hay que cuidar codo, hombro o muñeca", "Núcleo más blando y menos peso"],
  ["Edad", "Si hace falta una pala junior", "Tamaño y peso de la pala"],
  ["Presupuesto", "Tu tope de gasto", "Solo ves palas que puedes pagar"],
];

const formas: { forma: Forma; punto: number; texto: string }[] = [
  {
    forma: "redonda",
    punto: 9,
    texto:
      "Punto dulce amplio y centrado, balance bajo. Perdona los golpes descentrados. La elección habitual para empezar o si arrastras molestias.",
  },
  {
    forma: "lagrima",
    punto: 9,
    texto:
      "Punto dulce algo más arriba, balance medio. Un término medio entre control y pegada para cuando ya llevas un tiempo jugando.",
  },
  {
    forma: "diamante",
    punto: 7,
    texto:
      "Punto dulce pequeño y alto, balance en cabeza. Más pegada en el remate a cambio de perdonar menos y exigirle más al brazo.",
  },
];
---

<Base
  titulo={`${sitio.nombre} · Recomendador de palas de pádel`}
  tituloCompleto
  cabecera="ninguna"
  pie="completo"
>
  <header class="hero dk">
    <svg class="court" aria-hidden="true" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke-opacity="0.26" stroke-width="3" style="stroke: var(--blanco)">
        <path class="ct" pathLength="1" d="M700 96 L1600 96 L1600 716 L700 716 Z"></path>
        <path class="ct" pathLength="1" style="animation-delay:.25s" d="M1150 96 L1150 716"></path>
        <path class="ct" pathLength="1" style="animation-delay:.45s" d="M880 96 L880 716"></path>
        <path class="ct" pathLength="1" style="animation-delay:.6s" d="M880 406 L1440 406"></path>
      </g>
    </svg>

    <div class="contenedor hero-dentro">
      <Navegacion tono="oscuro" accion="acceder" />

      <div class="hero-cuerpo">
        <div class="hero-texto">
          <h1 class="titulo r2">La pala que encaja con cómo juegas.</h1>
          <p class="hero-lead r3">
            Responde 6 preguntas sobre tu juego. Te decimos qué pala te conviene, por qué, y en qué tienda está más
            barata hoy.
          </p>
          <div class="hero-acciones r4">
            <a class="btn btn-xl btn-lima" href={rutas.encuesta}>
              Empezar el cuestionario
            </a>
            <a class="lnk lnk-alto como" href={rutas.comoFunciona}>Cómo funciona</a>
          </div>
          <ul class="hero-puntos r4">
            <li>6 preguntas</li>
            <li>Sin registro</li>
            <li>No vendemos palas</li>
          </ul>
        </div>

        <div class="hero-dibujo floaty">
          <svg
            viewBox="0 0 720 660"
            role="img"
            aria-label="Dibujo técnico de una pala de pádel con las cinco variables que ajustamos: forma, punto dulce, balance, núcleo y peso"
          >
            <defs>
              <pattern id="holes" width="36" height="36" patternUnits="userSpaceOnUse">
                <circle cx="9" cy="9" r="5.6" style="fill: var(--azul)"></circle>
                <circle cx="27" cy="27" r="5.6" style="fill: var(--azul)"></circle>
              </pattern>
              <clipPath id="face"><ellipse cx="260" cy="190" rx="112" ry="116"></ellipse></clipPath>
            </defs>
            <g class="recoil">
              <g transform="translate(110 10) rotate(-10 260 320)">
                <rect x="236" y="360" width="48" height="240" rx="9" style="fill: var(--noche)"></rect>
                <g stroke-width="3" stroke-linecap="round" style="stroke: var(--linea-noche)">
                  <path d="M238 420 L282 404"></path>
                  <path d="M238 450 L282 434"></path>
                  <path d="M238 480 L282 464"></path>
                  <path d="M238 510 L282 494"></path>
                  <path d="M238 540 L282 524"></path>
                  <path d="M238 570 L282 554"></path>
                </g>
                <rect x="229" y="592" width="62" height="20" rx="8" style="fill: var(--lima)"></rect>
                <path
                  d="M260 40 C350 40 415 105 415 195 C415 285 345 320 294 372 L226 372 C175 320 105 285 105 195 C105 105 170 40 260 40 Z" style="fill: var(--blanco)"></path>
                <rect class="holes" x="130" y="60" width="260" height="260" fill="url(#holes)" clip-path="url(#face)"
                ></rect>
                <path
                  class="dr"
                  pathLength="1"
                  d="M260 40 C350 40 415 105 415 195 C415 285 345 320 294 372 L226 372 C175 320 105 285 105 195 C105 105 170 40 260 40 Z"
                  fill="none"
                  stroke-width="9"
                  stroke-linejoin="round" style="stroke: var(--noche)"></path>
                <path d="M234 322 L286 322 L260 360 Z" stroke-width="5" stroke-linejoin="round" style="fill: var(--azul); stroke: var(--noche)"
                ></path>
                <ellipse
                  cx="260"
                  cy="185"
                  rx="60"
                  ry="66"
                  fill="none"
                  stroke-width="2"
                  stroke-dasharray="3 8"
                  stroke-linecap="round" style="stroke: var(--noche)"></ellipse>
                <circle cx="260" cy="300" r="6" style="fill: var(--noche)"></circle>
              </g>
              <circle class="golpe" cx="346.5" cy="197" r="17" fill="none" stroke-width="3" style="stroke: var(--lima)"></circle>
            </g>
            <g class="ball">
              <circle cx="346.5" cy="197" r="16" style="fill: var(--lima)"></circle>
              <path
                d="M334 190 C342 196 351 196 359 190"
                fill="none"
                stroke-opacity=".45"
                stroke-width="1.6"
                stroke-linecap="round" style="stroke: var(--tinta)"></path>
            </g>
            <g class="rotulos" font-size="18" style="fill: var(--lima)">
              <g class="co" style="animation-delay:1.7s">
                <path d="M438 78 L498 48 L520 48" fill="none" stroke-width="1.6" style="stroke: var(--blanco)"></path>
                <circle cx="438" cy="78" r="4.5"></circle>
                <text x="530" y="44">Forma</text>
                <text class="val" x="530" y="72">lágrima</text>
              </g>
              <g class="co" style="animation-delay:1.85s">
                <path d="M362 205 L520 252 L546 252" fill="none" stroke-width="1.6" style="stroke: var(--blanco)"></path>
                <text x="556" y="248">Punto dulce</text>
                <text class="val" x="556" y="276">amplio</text>
              </g>
              <g class="co" style="animation-delay:2s">
                <path d="M398 488 L520 470 L546 470" fill="none" stroke-width="1.6" style="stroke: var(--blanco)"></path>
                <circle cx="398" cy="488" r="4.5"></circle>
                <text x="556" y="466">Peso</text>
                <text class="val" x="556" y="494">360 g</text>
              </g>
              <g class="co" style="animation-delay:2.15s" text-anchor="end">
                <path d="M195.5 234 L136 268 L112 268" fill="none" stroke-width="1.6" style="stroke: var(--blanco)"></path>
                <circle cx="195.5" cy="234" r="4.5"></circle>
                <text x="102" y="264">Núcleo</text>
                <text class="val" x="102" y="292">EVA blanda</text>
              </g>
              <g class="co" style="animation-delay:2.3s" text-anchor="end">
                <path d="M366.5 310 L150 392 L124 392" fill="none" stroke-width="1.6" style="stroke: var(--blanco)"></path>
                <text x="114" y="388">Balance</text>
                <text class="val" x="114" y="416">medio</text>
              </g>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </header>

  <main id="contenido">
    <section id="como-funciona" class="contenedor como-funciona">
      <div class="cabeza-seccion rv">
        <h2 class="titulo t-seccion">Del «no sé cuál comprar» a tu pala, en tres pasos.</h2>
        <p class="suave pretty">
          Sin jerga de catálogo. Si un término técnico importa, te lo explicamos en la misma frase.
        </p>
      </div>
      <ol class="rejilla pasos">
        {
          pasos.map(({ titulo, texto }, i) => (
            <li class:list={["paso rv", { oscuro: i === pasos.length - 1 }]}>
              <h3 class="subtitulo">{titulo}</h3>
              <p class="pretty">{texto}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="contenedor piezas">
      <div class="piezas-caja rv">
        <h2 class="titulo">Cada respuesta mueve una pieza de la pala.</h2>
        <p class="suave pretty intro">Esto es lo que preguntamos y lo que cambia según lo que contestes.</p>
        <table>
          <thead>
            <tr>
              <th scope="col">Pregunta</th>
              <th scope="col">Qué nos dice</th>
              <th scope="col">Qué cambia en la pala</th>
            </tr>
          </thead>
          <tbody>
            {
              preguntas.map(([pregunta, dice, cambia], i) => (
                <tr>
                  <th scope="row">
                    <span class="mono n">{i + 1}</span>
                    {pregunta}
                  </th>
                  <td class="dice" data-rotulo="Qué nos dice">
                    {dice}
                  </td>
                  <td class="cambia" data-rotulo="Qué cambia en la pala">
                    {cambia}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="contenedor formas">
      <div class="rv cabeza-formas">
        <h2 class="titulo t-seccion">Redonda, lágrima o diamante.</h2>
        <p class="suave pretty">
          La forma decide dónde queda el punto dulce y cuánto perdona la pala cuando no golpeas en el centro.
        </p>
      </div>
      <div class="rejilla">
        {
          formas.map(({ forma, punto, texto }) => (
            <article class="forma card card-enlace rv">
              <div class="forma-dibujo">
                <Silueta forma={forma} ancho={150} cara="blanca" trazo={5} punto={punto} anillo class="diagrama-forma" />
              </div>
              <div class="forma-texto">
                <h3 class="subtitulo">
                  <a class="cubre" href={rutas.palasPorForma(forma)} aria-label={`Ver palas de forma ${textoForma[forma].toLowerCase()}`}>
                    {textoForma[forma]}
                  </a>
                </h3>
                <p class="suave pretty">
                  <strong class="azul">{textoCaracter[forma]}.</strong> {texto}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="guias" class="contenedor guias">
      <div class="cabeza-guias rv">
        <h2 class="titulo t-seccion">Guías para elegir bien</h2>
        <a class="lnk lnk-azul lnk-alto" href={rutas.guias}>Ver todas las guías</a>
      </div>
      <ListaGuias guias={guiasDestacadas} class="rv" />
    </section>

    <section class="banda-pista dk">
      <svg class="pista" aria-hidden="true" viewBox="0 0 1440 360" preserveAspectRatio="xMidYMid slice">
        <g fill="none" stroke-opacity="0.24" stroke-width="3" style="stroke: var(--blanco)">
          <path d="M-20 300 L1460 300"></path>
          <path d="M1040 -20 L1040 380"></path>
          <path d="M1040 150 L1460 150"></path>
        </g>
        <circle cx="1180" cy="120" r="26" style="fill: var(--lima)"></circle>
      </svg>
      <div class="contenedor cierre rv">
        <h2 class="titulo">Seis preguntas y sabes qué pala comprar.</h2>
        <a class="btn btn-xl btn-lima" href={rutas.encuesta}>
          Empezar el cuestionario
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  /* --- Hero --- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--azul);
    color: var(--blanco);
  }
  .court {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-dentro {
    position: relative;
  }
  .hero-cuerpo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 40px;
    /* Mantiene la altura del hero que tenía con el rótulo, para que las líneas de pista no crucen la navegación. */
    padding: 56px 0 92px;
  }
  .hero-texto {
    flex: 1.15 1 460px;
    min-width: 0;
  }
  .hero h1 {
    font-size: clamp(46px, 6.1vw, 84px);
    line-height: 0.94;
    letter-spacing: -0.035em;
  }
  .hero-lead {
    margin: 26px 0 0;
    max-width: 520px;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.5;
    color: var(--sobre-azul);
    text-wrap: pretty;
  }
  .hero-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
    margin-top: 36px;
  }
  .como {
    font-weight: 600;
    color: var(--blanco);
  }
  /* Tres hechos en fila, separados por aire: sin puntos ni mono. */
  .hero-puntos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    font-weight: 500;
    color: var(--sobre-azul);
  }
  .hero-dibujo {
    flex: 1 1 380px;
    min-width: 0;
    max-width: 640px;
    margin: 0 auto;
  }
  .hero-dibujo svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .rotulos {
    font-family: var(--f-texto);
    font-weight: 500;
  }
  .rotulos .val {
    font-family: var(--f-texto);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0;
    fill: var(--blanco);
  }

  /* Animaciones del dibujo: la pista y el contorno se trazan, la bola golpea y la pala retrocede. */
  .ct {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.9s cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }
  .hero-dibujo .dr {
    animation-delay: 0.25s;
  }
  .hero-dibujo .holes {
    animation-delay: 1s;
  }
  .co {
    opacity: 0;
    animation: rise 0.6s var(--curva) forwards;
  }
  /* El golpe se juega una vez y el dibujo se queda quieto (nada se mueve más de 5 s). */
  .floaty {
    animation: flotar 4s ease-in-out 1;
  }
  .recoil {
    transform-origin: 422px 625px;
    animation: retroceso 8s 1.4s 1 both;
  }
  .ball {
    transform-box: fill-box;
    transform-origin: center;
    animation: bola 8s 1.4s 1 both;
  }
  .golpe {
    transform-box: fill-box;
    transform-origin: center;
    animation: onda 8s 1.4s 1 both;
  }
  @keyframes flotar {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  @keyframes bola {
    0% {
      transform: translate(340px, -300px);
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    12% {
      transform: translate(0, 0);
    }
    13.5% {
      transform: translate(0, 0) scale(1.25, 0.78);
    }
    27% {
      transform: translate(300px, 200px);
      opacity: 1;
    }
    31%,
    100% {
      transform: translate(350px, 260px);
      opacity: 0;
    }
  }
  @keyframes onda {
    0%,
    11.5% {
      transform: scale(0.4);
      opacity: 0;
    }
    12.5% {
      transform: scale(0.5);
      opacity: 1;
    }
    34%,
    100% {
      transform: scale(3.4);
      opacity: 0;
    }
  }
  @keyframes retroceso {
    0%,
    11.5% {
      transform: rotate(0deg);
    }
    15% {
      transform: rotate(-3.4deg);
    }
    27%,
    100% {
      transform: rotate(0deg);
    }
  }

  /* --- Piezas comunes de la portada --- */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .azul {
    color: var(--azul);
  }
  .lima {
    color: var(--lima);
  }

  /* --- Cómo funciona --- */
  .como-funciona {
    padding-block: clamp(64px, 8vw, 112px) clamp(48px, 6vw, 80px);
  }
  .cabeza-seccion {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
    margin-bottom: 56px;
  }
  .cabeza-seccion h2 {
    max-width: 640px;
  }
  .cabeza-seccion p {
    margin: 0;
    max-width: 380px;
  }
  .paso {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px;
    border-radius: 20px;
    background: var(--blanco);
    border: 1px solid var(--borde);
  }
  .paso h3 {
    font-size: 28px;
  }
  .paso p {
    margin: 0;
    color: var(--suave);
  }
  .paso.oscuro {
    background: var(--tinta);
    border-color: var(--tinta);
    color: var(--blanco);
  }
  .paso.oscuro p {
    color: var(--sobre-noche);
  }

  /* --- Cada respuesta mueve una pieza --- */
  .piezas {
    padding-block: clamp(32px, 4vw, 56px) clamp(64px, 8vw, 104px);
  }
  .piezas-caja {
    padding: clamp(24px, 4vw, 56px);
    border-radius: 28px;
    background: var(--blanco);
    border: 1px solid var(--borde);
  }
  .piezas h2 {
    margin-bottom: 12px;
    max-width: 720px;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1.02;
  }
  .piezas .intro {
    margin: 0 0 36px;
    max-width: 620px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  thead th {
    padding: 0 16px 14px 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--suave);
  }
  thead th:first-child {
    width: 26%;
  }
  thead th:nth-child(2) {
    width: 36%;
  }
  tbody tr {
    border-top: 1px solid var(--borde);
  }
  tbody th {
    padding: 20px 16px 20px 0;
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  tbody th .n {
    margin-right: 12px;
    font-size: 13px;
    font-weight: 400;
    color: var(--azul);
  }
  td {
    padding: 20px 16px 20px 0;
  }
  td.dice {
    color: var(--suave);
  }
  td.cambia {
    padding-right: 0;
    font-weight: 600;
  }

  /* --- Formas --- */
  .formas {
    padding-bottom: clamp(72px, 9vw, 120px);
  }
  .cabeza-formas {
    margin-bottom: 48px;
  }
  .cabeza-formas h2 {
    margin-bottom: 14px;
  }
  .cabeza-formas p {
    margin: 0;
    max-width: 560px;
  }
  .forma {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    background: var(--blanco);
    border: 1px solid var(--borde);
    overflow: hidden;
  }
  .forma.card:hover {
    transform: translateY(-8px);
  }
  .forma-dibujo {
    display: flex;
    justify-content: center;
    padding: 32px 0 20px;
    background: var(--tenue);
  }
  .forma-texto {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
  }
  .forma h3 {
    font-size: 32px;
    line-height: 1;
  }
  .forma h3 a {
    text-decoration: none;
  }
  .forma p {
    margin: 0;
  }
  .forma :global(.spot) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .forma:hover :global(.spot) {
    animation: latido 1.1s ease-out infinite;
  }
  @keyframes latido {
    0% {
      transform: scale(1);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  /* --- Transparencia --- */
  .transparencia {
    background: var(--noche);
    color: var(--blanco);
  }
  .transparencia > .contenedor {
    padding-block: clamp(64px, 8vw, 112px);
  }
  .transparencia h2 {
    margin-bottom: 56px;
    max-width: 900px;
    font-size: clamp(34px, 4.6vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .columnas {
    gap: 40px 48px;
  }
  .columnas > div {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 24px;
    border-top: 1.5px solid var(--linea-noche);
  }
  .columnas h3 {
    font-size: 25px;
