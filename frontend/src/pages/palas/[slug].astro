---
import AvisoPrecio from "@/components/AvisoPrecio";
import GuardarPala from "@/components/GuardarPala";
import HistoricoPrecio from "@/components/HistoricoPrecio.astro";
import Icono from "@/components/Icono";
import PalaMini from "@/components/PalaMini";
import { PalaGrande, descripcionForma } from "@/components/dibujos";
import { nombreTienda, palas } from "@/data/catalogo";
import Base from "@/layouts/Base.astro";
import {
  type Pala,
  euros,
  formaEnFrase,
  mejorOferta,
  ofertasDisponibles,
  ofertasOrdenadas,
  precioDesde,
  textoBalance,
  textoDisponibilidad,
  textoForma,
  textoFormaPlural,
  textoNivel,
  textoPeso,
} from "@/lib/catalogo";
import { preguntasFrecuentes } from "@/lib/fichas";
import { diferenciaCorta, palasParecidas } from "@/lib/recomendador";
import { rutas } from "@/lib/rutas";

// Ficha estática por modelo. Más adelante: leer GET /internas/catalogo en el build.
export function getStaticPaths() {
  return palas.map((pala) => ({ params: { slug: pala.slug }, props: { pala } }));
}

const { pala } = Astro.props as { pala: Pala };

const mejor = mejorOferta(pala);
const ofertas = ofertasOrdenadas(pala);
const disponibles = ofertasDisponibles(pala);
const precio = precioDesde(pala);
const parecidas = palasParecidas(pala, palas);
const faq = preguntasFrecuentes(pala);

const categoria = pala.junior
  ? { texto: "Junior", href: rutas.palasPorForma("junior") }
  : { texto: textoFormaPlural[pala.forma], href: rutas.palasPorForma(pala.forma) };

const especificaciones = [
  ["Forma", textoForma[pala.forma]],
  ["Balance", textoBalance[pala.balance]],
  ["Peso", textoPeso(pala)],
  ["Núcleo", pala.nucleo],
  ["Caras", pala.carasTexto],
  ["Nivel", textoNivel(pala.nivel)],
];

const descripcion = `${pala.nombre}: pala ${pala.junior ? "junior " : ""}${formaEnFrase(pala.forma)} de balance ${textoBalance[pala.balance].toLowerCase()}. Compara su precio en ${ofertas.length} tiendas, desde ${euros(precio)}.`;

const url = (ruta: string) => new URL(ruta, Astro.site).href;
const datosEstructurados = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: pala.nombre,
    description: pala.resumen,
    brand: { "@type": "Brand", name: pala.marca },
    category: "Palas de pádel",
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "EUR",
      lowPrice: precio.toFixed(2),
      highPrice: Math.max(...ofertas.map((o) => o.precio)).toFixed(2),
      offerCount: ofertas.length,
      availability: disponibles.length ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Palas", item: url(rutas.palas) },
      { "@type": "ListItem", position: 2, name: categoria.texto, item: url(categoria.href) },
      { "@type": "ListItem", position: 3, name: pala.nombre, item: url(rutas.pala(pala.slug)) },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(({ pregunta, respuesta }) => ({
      "@type": "Question",
      name: pregunta,
      acceptedAnswer: { "@type": "Answer", text: respuesta },
    })),
  },
];
---

<Base
  titulo={`${pala.nombre} · ficha y mejor precio`}
  descripcion={descripcion}
  accion="cuestionario"
  activo="palas"
  pie="compacto"
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(datosEstructurados)} />

  <main id="contenido" class="contenedor ficha">
    <div class="arriba">
      <nav aria-label="Migas de pan">
        <ol class="migas">
          <li><a class="lnk lnk-alto" href={rutas.palas}>Palas</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="lnk lnk-alto" href={categoria.href}>{categoria.texto}</a></li>
          <li aria-hidden="true">/</li>
          <li class="actual" aria-current="page">{pala.nombre}</li>
        </ol>
      </nav>

      <section class="hero">
        <div class="hero-dibujo dk s1">
          <svg class="pista" aria-hidden="true" viewBox="0 0 520 620" preserveAspectRatio="xMidYMid slice">
            <g fill="none" stroke-opacity="0.2" stroke-width="2.5" style="stroke: var(--blanco)">
              <path d="M-10 440 L530 440"></path>
              <path d="M260 440 L260 640"></path>
              <path d="M-10 90 L530 90"></path>
            </g>
          </svg>
          <PalaGrande
            class="pala"
            forma={pala.forma}
            caras={pala.caras}
            uid="ficha"
            animada
            etiqueta={`Diagrama de la pala ${pala.nombre}: ${descripcionForma(pala.forma)}`}
          />
        </div>

        <div class="hero-datos s2">
          <div class="nombre">
            <span class="etiqueta marca">{pala.marca} · Temporada {pala.temporada}</span>
            <h1 class="titulo">{pala.nombre}</h1>
            <p class="resumen">{pala.resumen}</p>
          </div>

          <dl class="especificaciones">
            {
              especificaciones.map(([clave, valor]) => (
                <div>
                  <dt>{clave}</dt>
                  <dd>{valor}</dd>
                </div>
              ))
            }
          </dl>

          <div class="precio-caja">
            {
              mejor ? (
                <>
                  <div class="precio-datos">
                    <span class="precio-tienda">Mejor precio hoy · {nombreTienda(mejor.tienda)}</span>
                    <span class="precio-valor">{euros(mejor.precio)}</span>
                    <a class="lnk lnk-azul lnk-alto comparar" href="#precios">
                      {disponibles.length > 1 ? `Comparar en ${ofertas.length} tiendas` : "Ver precio por tienda"}
                    </a>
                  </div>
                  <div class="precio-accion">
                    <a
                      class="btn btn-l btn-azul"
                      href={rutas.tienda(mejor.id, { origen: "ficha" })}
                      rel="sponsored nofollow noopener"
                      aria-label={`Ir a la tienda ${nombreTienda(mejor.tienda)}, enlace de afiliado`}
                    >
                      Ir a la tienda
                      <Icono nombre="salida" tamano={20} grosor={2.4} class="arr" />
                    </a>
                    <span class="precio-nota">Enlace de afiliado. A ti te cuesta lo mismo.</span>
                  </div>
                </>
              ) : (
                <div class="precio-datos">
                  <span class="precio-tienda">Agotada hoy en todas las tiendas</span>
                  <span class="precio-valor">{euros(precio)}</span>
                  <a class="lnk lnk-azul lnk-alto comparar" href="#precios">
                    Ver precio por tienda
                  </a>
                </div>
              )
            }
          </div>

          <GuardarPala slug={pala.slug} client:load />
        </div>
      </section>
    </div>

    <section class="encaje rv">
      <div class="si">
        <h2 class="titulo">Es para ti si…</h2>
        <ul>
          {
            pala.paraTi.map((texto) => (
              <li>
                <Icono nombre="check" grosor={2.6} color="var(--azul)" />
                <span>{texto}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="no">
        <h2 class="titulo">Mejor otra si…</h2>
        <ul>
          {
            pala.mejorOtra.map((texto) => (
              <li>
                <Icono nombre="cruz" grosor={2.6} color="var(--tinta)" />
                <span>{texto}</span>
              </li>
            ))
          }
        </ul>
        <a class="lnk lnk-azul lnk-alto" href={rutas.encuesta}>Haz el cuestionario y te decimos cuál</a>
      </div>
    </section>

    <section id="precios" class="precios rv">
      <div class="precios-cabeza">
        <h2 class="titulo t-bloque">Precio por tienda</h2>
        <p>Precios revisados a diario. Todos los enlaces son de afiliado.</p>
      </div>
      <div class="tabla-caja">
        <table>
          <thead>
            <tr>
              <th scope="col">Tienda</th>
              <th scope="col">Disponibilidad</th>
              <th scope="col" class="der">Precio</th>
              <th scope="col"><span class="solo-lectores">Enlace a la tienda</span></th>
            </tr>
          </thead>
          <tbody>
            {
              ofertas.map((oferta) => {
                const tienda = nombreTienda(oferta.tienda);
                const esMejor = oferta === mejor;
                return (
                  <tr class:list={{ agotada: oferta.disponibilidad === "agotada" }}>
                    <th scope="row">
                      <span class="tienda">
                        {tienda}
                        {esMejor && <span class="distintivo">Mejor precio</span>}
                      </span>
                    </th>
                    <td class="disponibilidad">{textoDisponibilidad[oferta.disponibilidad]}</td>
                    <td class="precio">{euros(oferta.precio)}</td>
                    <td class="accion">
                      {oferta.disponibilidad === "agotada" ? (
                        <span class="sin-stock">Sin stock</span>
                      ) : (
                        <a
                          class:list={["btn ir", esMejor ? "btn-azul" : "btn-contorno"]}
                          href={rutas.tienda(oferta.id, { origen: "ficha" })}
                          rel="sponsored nofollow noopener"
                          aria-label={`Ir a ${tienda}, enlace de afiliado`}
                        >
                          Ir a la tienda
                          <Icono nombre="salida" tamano={16} grosor={2.6} class="arr" />
                        </a>
                      )}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="evolucion rv">
      <HistoricoPrecio pala={pala} />
      <AvisoPrecio slug={pala.slug} precioActual={precio} client:load />
    </section>

    <section class="banda-pista dk cta rv">
      <svg class="pista" aria-hidden="true" viewBox="0 0 1128 300" preserveAspectRatio="xMidYMid slice">
        <g fill="none" stroke-opacity="0.22" stroke-width="3" style="stroke: var(--blanco)">
          <path d="M-20 232 L1150 232"></path>
          <path d="M820 -20 L820 320"></path>
          <path d="M820 110 L1150 110"></path>
        </g>
        <circle cx="940" cy="86" r="22" style="fill: var(--lima)"></circle>
      </svg>
      <div class="cta-dentro">
        <h2 class="titulo">¿No tienes claro si es tu pala?</h2>
        <a class="btn btn-xl btn-lima" href={rutas.encuesta}>
          Responder 6 preguntas
        </a>
      </div>
    </section>

    {
      parecidas.length > 0 && (
        <section class="parecidas rv">
          <h2 class="titulo t-bloque">Palas parecidas</h2>
          <div class="rejilla-palas">
            {parecidas.map((otra) => (
              <PalaMini pala={otra} texto={diferenciaCorta(otra, pala)} />
            ))}
          </div>
        </section>
      )
    }

    <section class="faq rv">
      <h2 class="titulo t-bloque">Preguntas frecuentes</h2>
      <div class="faq-lista">
        {
          faq.map(({ pregunta, respuesta }) => (
            <details>
              <summary>
                {pregunta}
                <Icono nombre="mas" tamano={22} grosor={2.4} color="var(--azul)" class="pm" />
              </summary>
              <p>{respuesta}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<style>
  .ficha {
    display: flex;
    flex-direction: column;
    gap: clamp(44px, 5.5vw, 76px);
    padding-block: 20px clamp(56px, 7vw, 96px);
  }
  .arriba {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  /* --- Migas --- */
  .migas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14.5px;
    color: var(--suave);
  }
  .migas .actual {
    font-weight: 600;
    color: var(--tinta);
  }

  /* --- Cabecera de la ficha --- */
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: 28px 48px;
  }
  .hero-dibujo {
    position: relative;
    overflow: hidden;
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
    padding: 36px;
    border-radius: 28px;
    background: var(--azul);
  }
  .hero-dibujo .pista {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-dibujo :global(.pala) {
    position: relative;
    display: block;
    width: 100%;
    max-width: 330px;
    height: auto;
    transform: rotate(-8deg);
  }
  .hero-datos {
    flex: 1.35 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .nombre {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .marca {
    font-size: 13px;
  }
  h1 {
    font-size: clamp(40px, 5vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .resumen {
    margin: 4px 0 0;
    max-width: 580px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--suave);
    text-wrap: pretty;
  }
  .especificaciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr));
    gap: 1px;
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: var(--borde);
    border: 1px solid var(--borde);
  }
  .especificaciones > div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 14px 16px;
    background: var(--blanco);
  }
  .especificaciones dt {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--suave);
  }
  .especificaciones dd {
    margin: 0;
    font-weight: 700;
    font-size: 18px;
  }
  .precio-caja {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 20px 22px;
    border-radius: 18px;
    background: var(--blanco);
    border: 1.5px solid var(--tinta);
  }
  .precio-datos {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .precio-tienda {
    font-size: 15px;
    font-weight: 600;
  }
  .precio-valor {
    font-family: var(--f-titulo);
    font-weight: 800;
    font-size: 46px;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .comparar {
    font-size: 15px;
  }
  .precio-accion {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .precio-nota {
    font-size: 13.5px;
    color: var(--suave);
  }

  /* --- Es para ti / mejor otra --- */
  .encaje {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 20px;
  }
  .encaje > div {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(22px, 2.8vw, 36px);
    border-radius: 22px;
    background: var(--blanco);
    border: 1px solid var(--borde);
  }
  .encaje .no {
    background: var(--tenue);
  }
  .encaje h2 {
    font-size: 30px;
    letter-spacing: -0.025em;
  }
  .encaje ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .encaje li {
    display: flex;
    gap: 14px;
  }
  .encaje li :global(svg) {
    margin-top: 2px;
  }
  .encaje .no a {
    align-self: flex-start;
    margin-top: auto;
  }

  /* --- Precio por tienda --- */
  .precios {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .precios-cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 32px;
  }
  .precios-cabeza p {
    margin: 0;
    font-size: 15px;
    color: var(--suave);
  }
  .tabla-caja {
    border-radius: 20px;
    background: var(--blanco);
    border: 1px solid var(--borde);
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  thead th {
    padding: 18px 22px 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--suave);
  }
  .der {
    text-align: right;
  }
  tbody tr {
    border-top: 1px solid var(--borde);
    transition: background-color 0.15s;
  }
  tbody tr:hover {
    background-color: var(--fondo);
  }
  tbody th,
  tbody td {
    padding: 16px 22px;
  }
  tbody th {
    font-weight: 700;
  }
  .tienda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .disponibilidad {
    color: var(--suave);
  }
  td.precio {
    text-align: right;
    font-family: var(--f-titulo);
    font-weight: 800;
    font-size: 26px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  td.accion {
    text-align: right;
  }
  .ir {
    gap: 10px;
    height: 46px;
    padding: 0 18px;
    border-radius: 10px;
    font-size: 15.5px;
    font-weight: 700;
  }
  .agotada td.precio,
  .agotada th {
    color: var(--suave);
  }
  .sin-stock {
    font-size: 15px;
    color: var(--suave);
  }

  /* --- Histórico y aviso --- */
  .evolucion {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  /* --- Llamada al cuestionario --- */
  .cta {
    border-radius: 28px;
  }
  .cta-dentro {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: clamp(28px, 4.4vw, 56px);
  }
  .cta h2 {
    flex: 1 1 380px;
    max-width: 620px;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  /* --- Parecidas --- */
  .parecidas {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* --- Preguntas frecuentes --- */
  .faq {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 56px;
  }
  .faq h2 {
    flex: 1 1 260px;
  }
  .faq-lista {
    flex: 2.2 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-top: 1.5px solid var(--tinta);
  }
  details {
    border-bottom: 1px solid var(--borde);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 68px;
    padding: 12px 0;
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.015em;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(.pm) {
    transition: transform 0.25s var(--curva);
  }
  details[open] summary :global(.pm) {
    transform: rotate(45deg);
  }
  details p {
    margin: 0 0 22px;
    max-width: 640px;
    color: var(--suave);
    text-wrap: pretty;
  }

  /* --- Móvil --- */
  @media (max-width: 640px) {
    .hero-dibujo {
      min-height: 320px;
      padding: 28px;
    }
    .hero-dibujo :global(.pala) {
      max-width: 230px;
    }
    .precio-valor {
      font-size: 42px;
    }
    .precio-accion {
      width: 100%;
    }
    .precio-accion .btn {
      width: 100%;
    }

    /* La tabla de precios pasa a filas de dos líneas: tienda y precio; disponibilidad y botón. */
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    table,
    tbody {
      display: block;
    }
    tbody tr {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 10px 16px;
      padding: 18px;
    }
    tbody tr:first-child {
      border-top: 0;
    }
    tbody th,
    tbody td {
      padding: 0;
    }
    td.precio {
      font-size: 24px;
      text-align: left;
    }
    td.disponibilidad {
      text-align: right;
    }
    summary {
      font-size: 19px;
    }
  }
</style>
