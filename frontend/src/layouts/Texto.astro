---
/**
 * Página de lectura: guías, transparencia y textos legales.
 * Cabecera con migas y titular, columna de texto y una tarjeta lateral.
 */
import Bloques from "@/components/Bloques.astro";
import type { Bloque } from "@/data/guias";
import Base from "@/layouts/Base.astro";
import { type SeccionNav, pieLegal, rutas } from "@/lib/rutas";

interface Props {
  titulo: string;
  /** Título para <title>, si debe ser distinto del titular. */
  tituloPestana?: string;
  descripcion: string;
  kicker: string;
  resumen: string;
  /** Línea pequeña bajo el resumen: tiempo de lectura o fecha de actualización. */
  meta?: string;
  migas: { texto: string; href: string }[];
  activo?: SeccionNav;
  bloques: Bloque[];
  /** Tarjeta lateral: llamada al cuestionario o índice de textos legales. */
  lateral?: "cuestionario" | "legal";
}

const {
  titulo,
  tituloPestana = titulo,
  descripcion,
  kicker,
  resumen,
  meta,
  migas,
  activo,
  bloques,
  lateral = "cuestionario",
} = Astro.props;

const actual = Astro.url.pathname;
const enlacesLegales = [{ texto: "Cómo ganamos dinero", href: rutas.comoGanamosDinero }, ...pieLegal];
---

<Base titulo={tituloPestana} descripcion={descripcion} accion="cuestionario" activo={activo}>
  <main id="contenido" class="contenedor texto">
    <header class="cabeza s1">
      <nav aria-label="Migas de pan">
        <ol class="migas">
          {
            migas.map(({ texto, href }) => (
              <>
                <li>
                  <a class="lnk lnk-alto" href={href}>
                    {texto}
                  </a>
                </li>
                <li aria-hidden="true">/</li>
              </>
            ))
          }
          <li class="actual" aria-current="page">{kicker}</li>
        </ol>
      </nav>
      <h1 class="titulo">{titulo}</h1>
      <p class="resumen">{resumen}</p>
      {meta && <p class="etiqueta">{meta}</p>}
    </header>

    <div class="cuerpo s2">
      <article>
        <Bloques bloques={bloques} />
      </article>

      {
        lateral === "cuestionario" ? (
          <aside class="lateral dk" aria-label="Cuestionario">
            <h2 class="titulo">¿Prefieres que te lo digamos nosotros?</h2>
            <p>Seis preguntas sobre cómo juegas y te enseñamos tres palas, con su precio en cada tienda.</p>
            <a class="btn btn-l btn-lima" href={rutas.encuesta}>
              Empezar el cuestionario
            </a>
          </aside>
        ) : (
          <aside class="lateral indice" aria-label="Transparencia y textos legales">
            <p class="kicker">Transparencia y legal</p>
            <nav>
              {enlacesLegales.map(({ texto, href }) => (
                <a href={href} aria-current={actual === href ? "page" : undefined}>
                  {texto}
                </a>
              ))}
            </nav>
          </aside>
        )
      }
    </div>

    <slot />
  </main>
</Base>

<style>
  .texto {
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 5vw, 64px);
    padding-block: 20px clamp(56px, 7vw, 96px);
  }

  .cabeza {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .migas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14.5px;
    color: var(--suave);
  }
  .migas .actual {
    font-weight: 600;
    color: var(--tinta);
  }
  h1 {
    max-width: 940px;
    font-size: clamp(38px, 5vw, 68px);
    line-height: 0.97;
    letter-spacing: -0.035em;
  }
  .resumen {
    margin: 0;
    max-width: 720px;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--suave);
    text-wrap: pretty;
  }

  .cuerpo {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 40px 64px;
  }
  article {
    flex: 2 1 520px;
    min-width: 0;
    max-width: 760px;
  }

  .lateral {
    position: sticky;
    top: 24px;
    flex: 1 1 280px;
    min-width: 0;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: clamp(22px, 2.8vw, 32px);
    border-radius: 22px;
    background: var(--noche);
    color: var(--blanco);
  }
  .lateral h2 {
    font-size: 28px;
    line-height: 1.03;
    letter-spacing: -0.025em;
  }
  .lateral p:not(.kicker) {
    margin: 0;
    font-size: 15.5px;
    color: var(--sobre-noche);
    text-wrap: pretty;
  }
  .lateral .btn {
    margin-top: 6px;
  }
  /* En pantallas muy estrechas el botón ocupa todo el ancho para que su texto quepa en una línea. */
  @media (max-width: 400px) {
    .lateral .btn {
      width: 100%;
      padding-inline: 16px;
      font-size: 16px;
    }
  }

  .indice {
    align-items: stretch;
    gap: 10px;
    background: var(--blanco);
    border: 1px solid var(--borde);
    color: var(--tinta);
  }
  .indice nav {
    display: flex;
    flex-direction: column;
  }
  .indice a {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-top: 1px solid var(--borde);
    font-weight: 600;
    text-decoration: none;
  }
  .indice a:hover {
    color: var(--azul);
  }
  .indice a[aria-current="page"] {
    color: var(--azul);
  }

  @media (max-width: 900px) {
    .lateral {
      position: static;
      max-width: none;
    }
  }
</style>
