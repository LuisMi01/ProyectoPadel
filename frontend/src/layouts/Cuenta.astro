---
import Base from "@/layouts/Base.astro";
import { navegacionCuenta } from "@/lib/rutas";

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
const actual = Astro.url.pathname;
---

<Base titulo={titulo}>
  <div class="cuenta">
    <nav aria-label="Mi cuenta">
      {
        navegacionCuenta.map(({ texto, href }) => (
          <a href={href} aria-current={actual === href ? "page" : undefined}>
            {texto}
          </a>
        ))
      }
    </nav>
    <section>
      <h1>{titulo}</h1>
      <slot />
    </section>
  </div>
</Base>

<style>
  .cuenta {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(10rem, 14rem) 1fr;
  }
  @media (max-width: 40rem) {
    .cuenta {
      grid-template-columns: 1fr;
    }
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  nav a {
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
  }
  nav a[aria-current="page"] {
    background: var(--superficie);
    color: var(--acento);
    font-weight: 600;
  }
</style>
