---
/** Área de cuenta: titular, pestañas y el contenido de cada sección. */
import "@/styles/cuenta.css";
import Base from "@/layouts/Base.astro";
import { navegacionCuenta } from "@/lib/rutas";

interface Props {
  titulo: string;
  /** Una frase bajo el titular. */
  entrada: string;
}

const { titulo, entrada } = Astro.props;
const actual = Astro.url.pathname;
---

<Base titulo={`${titulo} · Tu cuenta`} accion="acceder" noindex>
  <main id="contenido" class="contenedor cuenta">
    <header class="cabeza s1">
      <p class="kicker">Tu cuenta</p>
      <h1 class="titulo">{titulo}</h1>
      <p class="entrada">{entrada}</p>
    </header>

    <nav class="pestanas s2" aria-label="Secciones de tu cuenta">
      {
        navegacionCuenta.map(({ texto, href }) => (
          <a href={href} aria-current={actual === href ? "page" : undefined}>
            {texto}
          </a>
        ))
      }
    </nav>

    <div class="s2">
      <slot />
    </div>
  </main>
</Base>

<style>
  .cuenta {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: clamp(32px, 5vw, 64px) clamp(56px, 7vw, 96px);
  }
  .cabeza {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h1 {
    font-size: clamp(36px, 4.6vw, 60px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .entrada {
    margin: 0;
    max-width: 620px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--suave);
    text-wrap: pretty;
  }

  .pestanas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 20px;
    border-bottom: 1.5px solid var(--tinta);
  }
  .pestanas a {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 44px;
    padding: 0 16px;
    border: 2px solid var(--borde);
    border-radius: 12px;
    background: var(--blanco);
    font-size: 15.5px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.15s,
      border-color 0.15s;
  }
  .pestanas a:hover {
    transform: translateY(-2px);
    border-color: var(--azul);
  }
  .pestanas a[aria-current="page"] {
    border-color: var(--azul);
    background: var(--azul);
    color: var(--blanco);
  }

  /* En móvil las pestañas se deslizan en horizontal. */
  @media (max-width: 640px) {
    .pestanas {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--margen) * -1);
      padding-inline: var(--margen);
      padding-top: 4px;
      scrollbar-width: none;
    }
    .pestanas::-webkit-scrollbar {
      display: none;
    }
  }
</style>
