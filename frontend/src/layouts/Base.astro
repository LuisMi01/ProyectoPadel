---
import "@/styles/global.css";
import { navegacion, rutas } from "@/lib/rutas";

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = "Encuentra la pala de pádel que encaja con tu juego." } = Astro.props;
const actual = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · ProyectoPadel</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={new URL(actual, Astro.site)} />
  </head>
  <body>
    <header class="cabecera">
      <nav class="contenedor" aria-label="Principal">
        <a href={rutas.inicio} class="logo">ProyectoPadel</a>
        <ul>
          {
            navegacion.map(({ texto, href }) => (
              <li>
                <a href={href} aria-current={actual.startsWith(href) ? "page" : undefined}>
                  {texto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="contenedor">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor suave">
        © {new Date().getFullYear()} ProyectoPadel ·
        <a href={rutas.guias}>Guías</a> ·
        <a href={rutas.acceso}>Acceder</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .cabecera {
    border-bottom: 1px solid var(--borde);
    background: var(--superficie);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.9rem;
  }
  .logo {
    font-weight: 800;
    text-decoration: none;
    background: linear-gradient(90deg, var(--acento), var(--acento-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    text-decoration: none;
  }
  ul a[aria-current="page"] {
    color: var(--acento);
    font-weight: 600;
  }
  .pie {
    border-top: 1px solid var(--borde);
    padding-block: 1.5rem;
    font-size: 0.9rem;
  }
</style>
