---
import "@/styles/global.css";
import Navegacion from "@/components/Navegacion.astro";
import Pie from "@/components/Pie.astro";
import { type SeccionNav, rutas } from "@/lib/rutas";
import { sitio } from "@/lib/sitio";

interface Props {
  /** Título de la página; se le añade la marca salvo que `tituloCompleto` sea true. */
  titulo: string;
  tituloCompleto?: boolean;
  descripcion?: string;
  /**
   * «clara»: cabecera blanca con navegación (la mayoría de páginas).
   * «ninguna»: la página pinta la suya (portada y cuestionario).
   */
  cabecera?: "clara" | "ninguna";
  /** Botón de la cabecera clara. */
  accion?: "acceder" | "cuestionario";
  activo?: SeccionNav;
  pie?: "completo" | "compacto" | "ninguno";
  /** Páginas personales o de paso que no deben indexarse. */
  noindex?: boolean;
}

const {
  titulo,
  tituloCompleto = false,
  descripcion = sitio.descripcion,
  cabecera = "clara",
  accion = "cuestionario",
  activo,
  pie = "completo",
  noindex = false,
} = Astro.props;

const tituloPagina = tituloCompleto ? titulo : `${titulo} · ${sitio.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1747C9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_ES" />
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    {
      cabecera === "clara" && (
        <header class="cabecera">
          <div class="contenedor">
            <Navegacion tono="claro" accion={accion} activo={activo} />
          </div>
        </header>
      )
    }

    <slot />

    {pie !== "ninguno" && <Pie variante={pie} />}

    <script is:inline define:vars={{ cuenta: rutas.cuenta }}>
      // Si ya hay una sesión recordada, «Acceder» pasa a ser «Mi cuenta».
      try {
        if (localStorage.getItem("palaideal:sesion")) {
          for (const enlace of document.querySelectorAll("[data-acceso]")) {
            enlace.textContent = "Mi cuenta";
            enlace.setAttribute("href", cuenta);
          }
        }
      } catch {
        /* sin almacenamiento: se queda «Acceder» */
      }
    </script>
  </body>
</html>

<style>
  .cabecera {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--borde);
    background: var(--blanco);
  }
</style>
